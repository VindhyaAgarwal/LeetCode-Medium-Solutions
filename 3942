class Solution {
    public int minOperations(int[] nums) {
        int n = nums.length;
        if (n == 1) return 0;
        if (n == 2) return nums[0] == 0 ? 0 : 1;

        int pos0 = -1, posMax = -1;
        for (int i = 0; i < n; i++) {
            int v = nums[i];
            if (v == 0) pos0 = i;
            else if (v == n - 1) posMax = i;
        }

        int ans = Integer.MAX_VALUE;

        boolean ok = true;
        int j = pos0;
        for (int i = 0; i < n; i++) {
            if (nums[j] != i) { ok = false; break; }
            if (++j == n) j = 0;
        }
        if (ok) {
            int c = pos0 < n - pos0 + 2 ? pos0 : n - pos0 + 2;
            ans = c;
        }

        ok = true;
        j = posMax;
        int m = n - 1;
        for (int i = 0; i < n; i++) {
            if (nums[j] != m - i) { ok = false; break; }
            if (++j == n) j = 0;
        }
        if (ok) {
            int c1 = posMax + 1;
            int c2 = n - posMax + 1;
            int c = c1 < c2 ? c1 : c2;
            if (c < ans) ans = c;
        }

        return ans == Integer.MAX_VALUE ? -1 : ans;
    }
}
