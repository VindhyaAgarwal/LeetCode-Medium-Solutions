class Solution {
    public boolean sumGame(String num) {
        int n = num.length();
        int half = n / 2;
        int sum1 = 0, sum2 = 0;
        int q1 = 0, q2 = 0;
        
        for (int i = 0; i < half; i++) {
            char c = num.charAt(i);
            if (c == '?') q1++;
            else sum1 += c - '0';
        }
        for (int i = half; i < n; i++) {
            char c = num.charAt(i);
            if (c == '?') q2++;
            else sum2 += c - '0';
        }
        
        int diff = sum1 - sum2;
        int diffQ = q2 - q1;
        
        if (diffQ == 0) {
            return diff != 0;
        }
        
        if (diffQ % 2 != 0) return true;
        return diff != 9 * diffQ / 2;
    }
}
