class Solution {
    int n;
    int[][] memo;
    int[] suffix;

    public int stoneGameII(int[] piles) {
        n = piles.length;
        memo = new int[n][n + 1];
        suffix = new int[n + 1];

        for (int i = n - 1; i >= 0; i--)
            suffix[i] = suffix[i + 1] + piles[i];

        return solve(0, 1);
    }

    private int solve(int i, int m) {
        if (2 * m >= n - i)
            return suffix[i];

        if (memo[i][m] != 0)
            return memo[i][m];

        int best = 0;

        for (int x = 1; x <= 2 * m; x++) {
            best = Math.max(
                best,
                suffix[i] - solve(i + x, Math.max(m, x))
            );
        }

        return memo[i][m] = best;
    }
}
