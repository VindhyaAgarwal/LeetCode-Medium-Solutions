class Solution {
    public long maxAlternatingSum(int[] nums) {
        int n = nums.length;
        for (int i = 0; i < n; i++) nums[i] = Math.abs(nums[i]);
        Arrays.sort(nums);

        long score = 0;
        int half = n / 2;
        for (int i = 0; i < half; i++) {
            long lo = nums[i], hi = nums[n - 1 - i];
            score += hi * hi - lo * lo;
        }
        if ((n & 1) == 1) {
            long mid = nums[half];
            score += mid * mid;
        }
        return score;
    }
}
