class Solution {
    public int minOperations(String s) {
        int n = s.length();
        char[] arr = s.toCharArray();
        int[] cnt = new int[26];
        for (char c : arr) cnt[c - 'a']++;
        char[] sorted = new char[n];
        int idx = 0;
        for (int i = 0; i < 26; i++) {
            char c = (char) ('a' + i);
            for (int j = 0; j < cnt[i]; j++) sorted[idx++] = c;
        }

        int L = 0;
        while (L < n && arr[L] == sorted[L]) L++;
        if (L == n) return 0;
        if (n == 2) return -1;

        int R = n - 1;
        while (arr[R] == sorted[R]) R--;

        if (L != 0 || R != n - 1) return 1;

        char minC = sorted[0];
        char maxC = sorted[n - 1];

        int f = 0;
        while (arr[f] != minC) f++;
        int g = n - 1;
        while (arr[g] != maxC) g--;

        if (f <= n - 2) return 2;
        if (g >= 1) return 2;

        return 3;
    }
}
