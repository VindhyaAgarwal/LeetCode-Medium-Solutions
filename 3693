class Solution {
    public int climbStairs(int n, int[] costs) {
        int[] dp = new int[n + 1];
        dp[0] = 0;
        for (int i = 1; i <= n; i++) {
            int c = costs[i - 1];
            int best = Integer.MAX_VALUE;
            if (i - 1 >= 0) best = Math.min(best, dp[i - 1] + c + 1);
            if (i - 2 >= 0) best = Math.min(best, dp[i - 2] + c + 4);
            if (i - 3 >= 0) best = Math.min(best, dp[i - 3] + c + 9);
            dp[i] = best;
        }
        return dp[n];
    }
}
