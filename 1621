class Solution {
    public int numberOfSets(int n, int k) {
        int MOD = 1_000_000_007;
        int N = n + k - 1;
        int R = 2 * k;
        if (R > N) return 0;
        R = Math.min(R, N - R);
        
        long num = 1, den = 1;
        for (int i = 0; i < R; i++) {
            num = num * (N - i) % MOD;
            den = den * (i + 1) % MOD;
        }
        
        return (int) (num * modPow(den, MOD - 2, MOD) % MOD);
    }
    
    private long modPow(long base, long exp, int mod) {
        long result = 1;
        base %= mod;
        while (exp > 0) {
            if ((exp & 1) == 1) result = result * base % mod;
            base = base * base % mod;
            exp >>= 1;
        }
        return result;
    }
}
