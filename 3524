class Solution {
    public long[] resultArray(int[] nums, int k) {
        long[] result = new long[k];
        long[] dp = new long[k];
        
        for (int num : nums) {
            int rem = num % k;
            long[] newDp = new long[k];
            
            for (int r = 0; r < k; r++) {
                if (dp[r] > 0) {
                    int newR = (r * rem) % k;
                    newDp[newR] += dp[r];
                }
            }
            
            newDp[rem] += 1;
            
            for (int r = 0; r < k; r++) {
                result[r] += newDp[r];
            }
            
            dp = newDp;
        }
        
        return result;
    }
}

