class Solution {
    public int minSwaps(int[] nums) {
        int n = nums.length;
        long[] enc = new long[n];
        for (int i = 0; i < n; i++) {
            int v = nums[i];
            int ds = digitSum(v);
            enc[i] = ((long) ds << 47) | ((long) v << 17) | i;
        }
        Arrays.sort(enc);
        int[] target = new int[n];
        for (int pos = 0; pos < n; pos++) {
            int origIdx = (int) (enc[pos] & 0x1FFFF);
            target[origIdx] = pos;
        }
        boolean[] visited = new boolean[n];
        int swaps = 0;
        for (int i = 0; i < n; i++) {
            if (visited[i] || target[i] == i) {
                visited[i] = true;
                continue;
            }
            int cycleLen = 0;
            int j = i;
            while (!visited[j]) {
                visited[j] = true;
                j = target[j];
                cycleLen++;
            }
            if (cycleLen > 1) swaps += cycleLen - 1;
        }
        return swaps;
    }
    private int digitSum(int x) {
        int sum = 0;
        while (x > 0) {
            sum += x % 10;
            x /= 10;
        }
        return sum;
    }
}
