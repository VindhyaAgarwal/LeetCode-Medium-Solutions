class Solution {
    public int countIslands(int[][] grid, int k) {
        int m = grid.length;
        int n = grid[0].length;
        int count = 0;
        int[] stack = new int[m * n];
        
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (grid[i][j] > 0) {
                    long sum = 0;
                    int top = 0;
                    stack[top++] = i * n + j;
                    
                    while (top > 0) {
                        int idx = stack[--top];
                        int r = idx / n;
                        int c = idx % n;
                        
                        if (grid[r][c] == 0) continue;
                        
                        sum += grid[r][c];
                        grid[r][c] = 0;
                        
                        if (r + 1 < m && grid[r + 1][c] > 0) stack[top++] = (r + 1) * n + c;
                        if (r - 1 >= 0 && grid[r - 1][c] > 0) stack[top++] = (r - 1) * n + c;
                        if (c + 1 < n && grid[r][c + 1] > 0) stack[top++] = r * n + (c + 1);
                        if (c - 1 >= 0 && grid[r][c - 1] > 0) stack[top++] = r * n + (c - 1);
                    }
                    
                    if (sum % k == 0) count++;
                }
            }
        }
        
        return count;
    }
}
