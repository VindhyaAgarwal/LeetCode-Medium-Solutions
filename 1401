class Solution {
    public boolean checkOverlap(int r, int cx, int cy, int x1, int y1, int x2, int y2) {
        int nearX = Math.max(x1, Math.min(cx, x2));
        int nearY = Math.max(y1, Math.min(cy, y2));
        
        int dx = cx - nearX;
        int dy = cy - nearY;
        
        return (dx * dx + dy * dy) <= r * r;
    }
}
